# Environment Variables
NODE_ENV=development
PORT=4000

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rinngos_db?schema=public"

# Redis Cache & Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Expiry
JWT_SECRET=rinngos_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=rinngos_refresh_secret_key_2026
JWT_REFRESH_EXPIRATION=7d

# Rate Limiting (Throttler)
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# CORS Whitelist (comma separated)
CORS_ORIGIN="http://localhost:3000,http://localhost:4000,https://www.rinngos.org"
