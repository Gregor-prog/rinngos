datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  SECRETARIAT_ADMIN
  MEMBER_NGO
}

enum MembershipStatus {
  PENDING
  APPROVED
  REJECTED
  REVALIDATED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum FeedbackCategory {
  GENERAL
  PROGRAMME
  MEMBERSHIP
  SAFEGUARDING
  WEBSITE
}

enum FeedbackStatus {
  NEW
  IN_REVIEW
  RESOLVED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(MEMBER_NGO)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Membership {
  id            String           @id @default(uuid())
  orgName       String
  acronym       String?
  contactName   String
  contactRole   String
  email         String
  phone         String
  cac           String
  lga           String
  thematic      String
  address       String
  status        MembershipStatus @default(PENDING)
  revalidatedAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([orgName])
  @@index([email])
  @@index([lga])
  @@index([status])
  @@map("memberships")
}

model ClinicKB {
  id        String   @id @default(uuid())
  keywords  String[]
  answer    String
  category  String   @default("General")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clinic_kb")
}

model Event {
  id            String              @id @default(uuid())
  title         String
  description   String
  date          DateTime
  location      String              @default("Online / Zoom")
  capacity      Int?
  registrations EventRegistration[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@map("events")
}

model EventRegistration {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fullName  String
  email     String
  createdAt DateTime @default(now())

  @@unique([eventId, email])
  @@map("event_registrations")
}

model CoworkingBooking {
  id        String        @id @default(uuid())
  fullName  String
  email     String
  date      DateTime
  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("coworking_bookings")
}

model Course {
  id          String            @id @default(uuid())
  trackName   String
  description String
  enrolments  CourseEnrolment[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("courses")
}

model CourseEnrolment {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  fullName  String
  org       String
  email     String
  phone     String
  createdAt DateTime @default(now())

  @@map("course_enrolments")
}

model Resource {
  id          String   @id @default(uuid())
  title       String
  category    String
  description String
  fileUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([title])
  @@index([category])
  @@map("resources")
}

model PartnershipEnquiry {
  id          String   @id @default(uuid())
  orgName     String
  contactName String
  email       String
  partnerType String
  details     String?
  createdAt   DateTime @default(now())

  @@map("partnership_enquiries")
}

model Feedback {
  id        String           @id @default(uuid())
  name      String?
  contact   String?
  category  FeedbackCategory @default(GENERAL)
  message   String
  status    FeedbackStatus   @default(NEW)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("feedbacks")
}

model ContactMessage {
  id        String   @id @default(uuid())
  fullName  String
  email     String
  phone     String?
  message   String
  createdAt DateTime @default(now())

  @@map("contact_messages")
}
